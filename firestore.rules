rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Disallow client-side writes to subscription / billing fields —
    // only the Cloud Function (Admin SDK, bypasses rules) may set them.
    function noProtectedKeys() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'subscriptionStatus',
          'subscriptionExpiresAt',
          'lemonsqueezyCustomerId',
          'lemonsqueezySubscriptionId',
          'lemonsqueezyCustomerPortalUrl'
        ]);
    }

    // ── users ─────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && noProtectedKeys();
      allow delete: if false;
    }

    // ── visionBoard ───────────────────────────────────────
    match /visionBoard/{docId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.userId);
      allow create:      if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── goals ─────────────────────────────────────────────
    match /goals/{docId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.userId);
      allow create:      if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── checkIns ──────────────────────────────────────────
    match /checkIns/{docId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.userId);
      allow create:      if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── gratitudeEntries ──────────────────────────────────
    match /gratitudeEntries/{docId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.userId);
      allow create:      if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── dailyLogs ─────────────────────────────────────────
    match /dailyLogs/{docId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.userId);
      allow create:      if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── gratitude (legacy) ────────────────────────────────
    match /gratitude/{docId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.userId);
      allow create:      if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── foundationHistory ─────────────────────────────────
    match /foundationHistory/{docId} {
      allow read:           if isSignedIn() && isOwner(resource.data.userId);
      allow create:         if isSignedIn() && isOwner(request.resource.data.userId);
      // Snapshots are immutable.
      allow update, delete: if false;
    }

    // ── resetSessions ─────────────────────────────────────
    match /resetSessions/{docId} {
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
      allow create:               if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── interruptResponses ────────────────────────────────
    match /interruptResponses/{docId} {
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
      allow create:               if isSignedIn() && isOwner(request.resource.data.userId);
    }

    // ── weeklyReflections ─────────────────────────────────
    match /weeklyReflections/{docId} {
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.userId);
      allow create:               if isSignedIn() && isOwner(request.resource.data.userId);
    }
  }
}
